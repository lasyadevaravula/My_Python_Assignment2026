CREATE TABLE Employees (
    emp_id NUMBER PRIMARY KEY,
    emp_name VARCHAR2(50),
    dept_id NUMBER,
    Salary NUMBER
);
drop table Employees;
INSERT INTO Employees VALUES (1, 'Ravi', 101, 20000);
INSERT INTO Employees VALUES (2, 'Priya', 102, 30000);
INSERT INTO Employees VALUES (3, 'Arun', 103, 40000);
INSERT INTO Employees VALUES (4, 'Neha', NULL, 45000);
CREATE TABLE Departments (
    dept_id NUMBER PRIMARY KEY,
    dept_name VARCHAR2(50)
);
drop table Departments;
INSERT INTO Departments VALUES (101, 'HR');
INSERT INTO Departments VALUES (102, 'IT');
INSERT INTO Departments VALUES (104, 'Finance');
SELECT e.emp_name, d.dept_name
FROM Employees e
INNER JOIN Departments d
ON e.dept_id = d.dept_id;
SELECT e.emp_name, d.dept_name from Employees e LEFT JOIN Departments d ON e.dept_id = d.dept_id;
SELECT e.emp_name FROM Employees e INNER JOIN Departments d ON e.dept_id = d.dept_id WHERE d.dept_name = 'IT';
SELECT e.emp_name, d.dept_name from Employees e LEFT JOIN Departments d ON d.dept_id = e.dept_id WHERE e.emp_id is null;
SELECT * from Employees where Salary > (select avg(Salary) from Employees group by dept_id)
select dept_id,avg(Salary) from Employees group by dept_id
select max(salary) from Employees
select max(salary) from Employees where Salary < (select max(salary) from Employees)
WITH High_Salary_Employees AS (
    SELECT emp_id,
           emp_name,
           salary,
           dept_id
    FROM employees
    WHERE salary > 30000
)
SELECT *
FROM High_Salary_Employees;
WITH Dept_Salary AS (
    SELECT dept_id,
           AVG(salary) AS avg_salary
    FROM employees
    GROUP BY dept_id
)
SELECT *
FROM Dept_Salary;
SELECT emp_id,
       emp_name,
       salary,
       ROW_NUMBER() OVER (ORDER BY salary DESC) AS row_num
FROM employees;
SELECT emp_id,
       emp_name,
       salary,
       RANK() OVER (ORDER BY salary DESC) AS salary_rank
FROM employees;
SELECT emp_id,
       emp_name,
       salary,
       DENSE_RANK() OVER (ORDER BY salary DESC) AS dense_rank
FROM employees;
SELECT *
FROM (
    SELECT emp_id,
           emp_name,
           dept_id,
           salary,
           ROW_NUMBER() OVER (
               PARTITION BY dept_id
               ORDER BY salary DESC
           ) AS rn
    FROM employees
)
WHERE rn <= 2;
SELECT *
FROM (
    SELECT emp_id,
           emp_name,
           dept_id,
           salary,
           ROW_NUMBER() OVER (
               PARTITION BY dept_id
               ORDER BY salary DESC
           ) AS rn
    FROM employees
)
WHERE rn = 1;
SELECT *
FROM (
    SELECT emp_id,
           emp_name,
           dept_id,
           salary,
           DENSE_RANK() OVER (
               PARTITION BY dept_id
               ORDER BY salary DESC
           ) AS dr
    FROM employees
)
WHERE dr = 2;
